# -----------------------------------------------------------------------------
# Anoneye environment
#
# Copy to `.env.local` and fill in what you need. Every integration is optional:
# with no values at all the app still builds and renders, and each feature says
# explicitly that it is not configured instead of inventing data.
#
# Never commit `.env.local` or real secrets. Server-only values must NOT be
# prefixed with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------

# Public origin of this deployment. No trailing slash.
# Used for canonical metadata, the sitemap, and the Meta OAuth redirect check.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional public contact address shown on /contact ("mailto:" link).
NEXT_PUBLIC_CONTACT_EMAIL=

# -----------------------------------------------------------------------------
# Supabase (production database + auth). Leave empty to use the local SQLite
# backend in development. Set BOTH Supabase values together.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required for encrypted OAuth tokens, scheduled syncs and contact
# messages. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Meta / Instagram / Facebook (live profile lookups + OAuth)
#
# After creating a Meta app:
#   Facebook Login -> Valid OAuth Redirect URIs:
#     ${NEXT_PUBLIC_SITE_URL}/api/oauth/meta/callback
#   Permissions: instagram_basic, instagram_manage_insights,
#                pages_read_engagement, pages_show_list, public_profile
#   For arbitrary public Pages additionally request Page Public Content Access
#   (App Review + business verification).
# See docs/API_CAPABILITIES.md and docs/DEPLOYMENT.md.
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/oauth/meta/callback

# Graph API version used for every request. Must look like v26.0.
META_GRAPH_VERSION=v26.0

# Optional: a server-side token for read-only lookups without per-user OAuth.
# Instagram Business Discovery needs the IG professional account id that owns
# the token. Both values are needed for Instagram; the token alone is enough
# for public Facebook Pages that grant access to your app.
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Required to store/decrypt OAuth tokens at rest. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key invalidates stored connected accounts (users reconnect).
TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Scheduled sync worker
# At least 16 characters. Callers must send `Authorization: Bearer <value>`.
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# Local development backend (SQLite). Disabled automatically in production.
# -----------------------------------------------------------------------------
# 1 = allow the local SQLite backend when Supabase is not configured.
ANONEYE_ALLOW_LOCAL_BACKEND=1
# File path for the local database, relative to the project root.
ANONEYE_LOCAL_DB_PATH=.data/anoneye.db

# -----------------------------------------------------------------------------
# Demo fixtures. 1 = enable the clearly labelled `anoneye.demo` fixture profile
# and sample history. Demo data is always badged and never presented as live.
# Use 0 (or omit) in production.
# -----------------------------------------------------------------------------
ANONEYE_DEMO_MODE=0
